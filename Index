<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Inventario Tarimas QR</title>
    
    <script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js"></script>
    <script src="https://unpkg.com/html5-qrcode"></script>
    
    <style>
        :root {
            --primary: #2563eb; --bg: #f3f4f6; --card: #ffffff;
            --text: #1f2937; --danger: #ef4444; --success: #218838; --warning: #f59e0b;
        }
        body { font-family: -apple-system, sans-serif; background: var(--bg); color: var(--text); margin: 0; padding: 10px; display: flex; flex-direction: column; align-items: center; }
        .app-card { background: white; width: 100%; max-width: 500px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); padding: 15px; box-sizing: border-box; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .field { margin-bottom: 12px; position: relative; }
        label { display: block; font-size: 0.75rem; font-weight: 800; color: #6b7280; margin-bottom: 4px; text-transform: uppercase; }
        select, input { width: 100%; padding: 12px; border: 1px solid #d1d5db; border-radius: 10px; font-size: 16px; box-sizing: border-box; background: white; }
        input[readonly] { background: #e5e7eb; color: #4b5563; font-weight: bold; }
        .btn-main { width: 100%; background: var(--primary); color: white; border: none; padding: 14px; border-radius: 10px; font-weight: bold; cursor: pointer; margin-top: 10px; }
        
        #reader { width: 100%; border-radius: 12px; overflow: hidden; margin-bottom: 15px; display: none; border: 2px solid var(--primary); background: black; min-height: 250px; position: relative; }
        
        .inv-item { background: var(--card); border-radius: 12px; margin-bottom: 8px; border: 1px solid #e5e7eb; overflow: hidden; }
        .inv-header { padding: 15px; background: #eef2ff; border-bottom: 1px solid #e5e7eb; display: flex; flex-direction: column; }
        .detail-row { padding: 12px 15px; border-bottom: 1px solid #eee; font-size: 0.85rem; display: flex; flex-direction: column; gap: 4px; position: relative; padding-right: 50px; }
        .btn-delete-row { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: #fee2e2; color: #dc2626; border: none; width: 32px; height: 32px; border-radius: 50%; font-weight: bold; cursor: pointer; }
        .badge { display: inline-block; padding: 4px 8px; border-radius: 6px; font-weight: bold; font-size: 0.8rem; background: var(--primary); color: white; }
    </style>
</head>
<body>

<div class="app-card">
    <header>
        <h2 style="margin:0; font-size: 1.2rem;">📦 Control de Tarimas QR</h2>
    </header>

    <div id="reader"></div>

    <button class="btn-main" onclick="toggleScanner()" style="margin-bottom: 15px; background: #374151;">📷 ESCANEAR ETIQUETA</button>

    <div class="field">
        <label>Número de Parte (Automático)</label>
        <input type="text" id="part-number" readonly placeholder="Escanea para obtener...">
    </div>
    
    <div class="field">
        <label>Serial (Automático)</label>
        <input type="text" id="serial-number" readonly placeholder="Escanea para obtener...">
    </div>

    <div class="field" style="display: flex; gap: 10px;">
        <div style="flex: 1;">
            <label>Tamaño Tarima</label>
            <select id="tarima-size" onchange="saveConfig()">
                <option value="40">40" x 40"</option>
                <option value="48">48" x 48"</option>
            </select>
        </div>
        <div style="flex: 1;">
            <label>Peso (Lbs)</label>
            <input type="number" id="tarima-weight" placeholder="0.00" inputmode="decimal">
        </div>
    </div>

    <button class="btn-main" onclick="agregar()">➕ AGREGAR A LA LISTA</button>

    <hr style="margin:20px 0; border:0; border-top:1px solid #eee;">
    
    <div id="contenedorPrincipal"></div>
    
    <div style="display: flex; gap: 10px; margin-top: 20px;">
        <button class="btn-main" onclick="descargarExcel()" style="background:var(--success); margin-top:0;">📊 EXPORTAR</button>
        <button class="btn-main" onclick="limpiarTodo()" style="background:var(--danger); margin-top:0;">🗑️ VACIAR</button>
    </div>
</div>

<script>
    let inventory = JSON.parse(localStorage.getItem('pallet_data_v1')) || [];
    let savedSize = localStorage.getItem('pallet_last_size') || "40";
    let html5QrCode;
    let flashEnabled = false;

    document.getElementById('tarima-size').value = savedSize;

    async function toggleScanner() {
        const readerDiv = document.getElementById('reader');
        if (readerDiv.style.display === 'block') { 
            stopScanner(); 
        } else {
            readerDiv.style.display = 'block';
            html5QrCode = new Html5Qrcode("reader");
            const configScan = { fps: 20, qrbox: { width: 250, height: 250 }, aspectRatio: 1.0, videoConstraints: { facingMode: "environment" } };

            try {
                await html5QrCode.start({ facingMode: "environment" }, configScan, onScanSuccess);
                setTimeout(async () => {
                    try {
                        const track = html5QrCode.getRunningTrack();
                        const capabilities = track.getCapabilities();
                        if (capabilities.torch || ('torch' in capabilities)) crearBotonFlash(track);
                    } catch (e) { console.warn("No flash support."); }
                }, 500);
            } catch (err) {
                alert("Error al iniciar cámara. Verifica permisos.");
                readerDiv.style.display = 'none';
            }
        }
    }

    function crearBotonFlash(track) {
        if (document.getElementById('btn-flash')) return;
        const btn = document.createElement('button');
        btn.id = 'btn-flash';
        btn.innerHTML = "🔦";
        btn.style = "position:absolute; top:10px; right:10px; z-index:99; padding:10px; background:#f59e0b; color:white; border:none; border-radius:50%; font-size:1.2rem;";
        btn.onclick = async () => {
            flashEnabled = !flashEnabled;
            await track.applyConstraints({ advanced: [{ torch: flashEnabled }] });
            btn.style.background = flashEnabled ? "#ef4444" : "#f59e0b";
        };
        document.getElementById('reader').appendChild(btn);
    }

    function onScanSuccess(decodedText) {
        // Separa el QR asumiendo el formato "Serial,Order,PartNumber,Qty,Weight"
        let parts = decodedText.split(',');
        
        if (parts.length < 3) {
            alert("Formato de QR no válido. Faltan comas.");
            return;
        }

        let serial = parts[0];
        let partNum = parts[2]; // Extrae "0051-884529-700" del índice 2

        // Validación: Comprueba que no haya números de parte diferentes
        if (inventory.length > 0) {
            let partEnCurso = inventory[0].partNumber;
            if (partNum !== partEnCurso) {
                alert(`¡ALERTA DE MEZCLA!\n\nEstás trabajando con el Número de Parte: ${partEnCurso}.\n\nEl QR escaneado tiene: ${partNum}.`);
                stopScanner();
                return;
            }
        }

        document.getElementById('part-number').value = partNum;
        document.getElementById('serial-number').value = serial;
        stopScanner();
    }

    function stopScanner() {
        if (html5QrCode) { 
            html5QrCode.stop().then(() => { 
                document.getElementById('reader').style.display = 'none'; 
                flashEnabled = false;
            }); 
        }
    }

    function saveConfig() {
        localStorage.setItem('pallet_last_size', document.getElementById('tarima-size').value);
    }

    function agregar() {
        const partNum = document.getElementById('part-number').value.trim();
        const serial = document.getElementById('serial-number').value.trim();
        const size = document.getElementById('tarima-size').value;
        const weight = parseFloat(document.getElementById('tarima-weight').value);

        if(!partNum || !serial || isNaN(weight)) return alert("Escanea el QR y asegúrate de agregar el peso.");

        // Doble validación por seguridad antes de insertar
        if (inventory.length > 0) {
            if (partNum !== inventory[0].partNumber) {
                return alert("¡Error! No puedes agregar un número de parte diferente a la lista actual.");
            }
        }

        inventory.unshift({ id: Date.now(), partNumber: partNum, serial: serial, size: size, weight: weight, time: new Date().toLocaleTimeString() });
        
        // Limpiar campos de entrada para el siguiente escaneo
        document.getElementById('serial-number').value = "";
        document.getElementById('tarima-weight').value = "";
        
        guardarYRenderizar();
    }

    function borrarRegistro(id) { 
        inventory = inventory.filter(i => i.id !== id); 
        guardarYRenderizar(); 
    }
    
    function limpiarTodo() { 
        if(confirm("¿Seguro que deseas borrar toda la lista actual?")) { 
            inventory = []; 
            document.getElementById('part-number').value = "";
            guardarYRenderizar(); 
        } 
    }

    function guardarYRenderizar() {
        localStorage.setItem('pallet_data_v1', JSON.stringify(inventory));
        const container = document.getElementById('contenedorPrincipal');
        container.innerHTML = "";

        if (inventory.length === 0) {
            container.innerHTML = "<div style='text-align:center; color:#9ca3af; padding:20px;'>No hay tarimas registradas.</div>";
            return;
        }

        let totalLbs = inventory.reduce((sum, item) => sum + item.weight, 0);

        const div = document.createElement("div");
        div.className = "inv-item";
        div.innerHTML = `
            <div class="inv-header">
                <span style="font-size:0.8rem; color:#6b7280;">NÚMERO DE PARTE ACTIVO</span>
                <b style="font-size:1.2rem; margin:5px 0;">${inventory[0].partNumber}</b>
                <div>
                    <span class="badge">Tarimas: ${inventory.length}</span>
                    <span class="badge" style="background:#4f46e5;">Total: ${totalLbs.toFixed(2)} lbs</span>
                </div>
            </div>
            <div>
                ${inventory.map(r => `
                <div class="detail-row">
                    <div><b>Serial:</b> ${r.serial}</div>
                    <div><b>Tamaño:</b> ${r.size}" | <b>Peso:</b> ${r.weight.toFixed(2)} lbs</div>
                    <div style="font-size:0.7rem; color:#9ca3af;">Hora: ${r.time}</div>
                    <button class="btn-delete-row" onclick="borrarRegistro(${r.id})">✕</button>
                </div>`).join('')}
            </div>`;
        container.appendChild(div);
    }

    function descargarExcel() {
        if (inventory.length === 0) return alert("No hay datos para exportar");
        
        let ws_data = [
            ["REPORTE DE TARIMAS ESCANEADAS", "", "", "", ""],
            ["FECHA:", new Date().toLocaleDateString(), "", "", ""],
            [],
            ["NÚMERO DE PARTE", "SERIAL", "TAMAÑO TARIMA", "PESO (LBS)", "HORA"]
        ];
        
        inventory.forEach(i => { 
            ws_data.push([i.partNumber, i.serial, i.size + '"', i.weight.toFixed(2), i.time]); 
        });
        
        const ws = XLSX.utils.aoa_to_sheet(ws_data);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Tarimas");
        XLSX.writeFile(wb, `Tarimas_${new Date().toISOString().slice(0,10)}.xlsx`);
    }

    window.onload = guardarYRenderizar;
</script>
</body>
</html>
